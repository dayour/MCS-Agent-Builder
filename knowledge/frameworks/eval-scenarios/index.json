{
  "version": "2.0",
  "source": "microsoft/eval-guide (Claude Code plugin)",
  "description": "Eval generation delegated to eval-guide plugin. This index retains bucket mapping rules and agent-type routing for enrichment fallback.",
  "pluginSkills": {
    "plan": "/eval-suite-planner",
    "generate": "/eval-generator",
    "interpret": "/eval-result-interpreter",
    "triage": "/eval-triage-and-improvement",
    "faq": "/eval-faq"
  },
  "bucketMapping": {
    "boundaries": {
      "passThreshold": null,
      "note": "Threshold determined by eval-guide risk-based model (safety/compliance category)",
      "scenarioCategories": ["CAP-SB", "CAP-CV", "CAP-RT2"],
      "coverageTags": ["core-business", "architecture"],
      "defaultMethods": [{ "type": "General quality" }, { "type": "Keyword match", "mode": "all" }]
    },
    "quality": {
      "passThreshold": null,
      "note": "Threshold determined by eval-guide risk-based model (core business + capability categories)",
      "scenarioCategories": ["BP-IR", "BP-TS", "BP-RS", "BP-PN", "BP-TR", "CAP-KG", "CAP-TI", "CAP-TR"],
      "coverageTags": ["core-business", "variations"],
      "defaultMethods": [{ "type": "General quality" }, { "type": "Compare meaning", "score": 70 }]
    },
    "edge-cases": {
      "passThreshold": null,
      "note": "Threshold determined by eval-guide risk-based model (edge cases category — iterate, don't block)",
      "scenarioCategories": ["CAP-TQ", "CAP-GF", "CAP-RT"],
      "coverageTags": ["variations", "edge-cases"],
      "defaultMethods": [{ "type": "General quality" }, { "type": "Compare meaning", "score": 60 }]
    }
  },
  "verdictModel": {
    "source": "eval-guide /eval-result-interpreter",
    "thresholds": {
      "safetyCompliance": { "target": 95, "block": 95 },
      "coreBusiness": { "target": 90, "block": 80 },
      "capability": { "target": 90, "block": 80 },
      "regression": { "target": 95, "block": 90 },
      "edgeCases": { "target": 70, "block": null, "note": "iterate, don't block" },
      "overall": { "target": 85, "block": 60 }
    },
    "verdicts": ["SHIP", "SHIP WITH KNOWN GAPS", "ITERATE", "BLOCK"],
    "riskProfiles": {
      "low-risk-internal": { "safetyDelta": -5, "coreDelta": -10, "capDelta": -10 },
      "medium-risk-customer-facing": { "safetyDelta": 0, "coreDelta": 0, "capDelta": 0 },
      "high-risk-regulated": { "safetyDelta": 3, "coreDelta": 7, "capDelta": 10 },
      "safety-critical": { "safetyDelta": 4, "coreDelta": 10, "capDelta": 15 }
    }
  },
  "agentTypeRouting": {
    "knowledge-answering": ["BP-IR", "CAP-KG", "CAP-CV"],
    "task-execution": ["BP-RS", "CAP-TI", "CAP-SB"],
    "diagnostic-guidance": ["BP-TS", "CAP-KG", "CAP-GF"],
    "multi-step-process": ["BP-PN", "CAP-TR", "CAP-TQ"],
    "multi-topic-routing": ["BP-TR", "CAP-TR", "CAP-GF"],
    "external-customer-service": ["CAP-TQ", "CAP-SB", "CAP-CV"],
    "sensitive-data": ["CAP-SB", "CAP-CV"],
    "pre-release-regression": ["CAP-RT"]
  }
}
