  "keyInsights": [
    "BotComponentInsert WORKS for new topics — this is the biggest discovery",
    "Request uses id=00000000-0000-0000-0000-000000000000 (zero GUID) — server assigns real ID",
    "No version, auditInfo, or parentBotId needed in insert request",
    "solutionId in request (00000001-...-9b) differs from response (fd140aae-...) — server overrides",
    "schemaName follows pattern: {botSchema}.topic.{TopicNameNoSpaces}",
    "Same PUT content/botcomponents endpoint — one endpoint for ALL component CRUD",
    "Variable interpolation: TextSegment + ExpressionSegment with ValueExpression",
    "Question action: variable=Topic.varName, entity=$kind:StringPrebuiltEntity (object, not string)",
    "No authorstate lock needed for new topics (only for updates)",
    "MCS handles NLU trigger registration, dependency tracking, compilation — all server-side"
  ],

  "yamlToJsonMapping_additions": {
    "kind: Question + variable + entity": "$kind: Question, variable: 'Topic.x', entity: {$kind: StringPrebuiltEntity}",
    "activity with {Topic.var}": "TemplateLine with TextSegment + ExpressionSegment(ValueExpression) interleaved",
