{# ── Customer Report — Non-technical stakeholders, execs ────── #}
{# All text uses the |jargon filter to strip technical terms.   #}
{% extends "base.njk" %}

{% block toc %}
  <a href="#what-we-are-building">What We're Building</a>
  <a href="#what-it-does">What It Does</a>
  <a href="#what-it-connects-to">Connections</a>
  <a href="#approach">Approach</a>
  <a href="#key-decisions">Key Decisions</a>
  <a href="#status">Current Status</a>
  <a href="#whats-next">What's Next</a>
  {% if openQuestions | selectattr("status", "ne", "resolved") | list | length > 0 %}
  <a href="#questions">Questions for Your Team</a>
  {% endif %}
{% endblock %}

{% block content %}
{# ── What We're Building ──────────────────────────────────── #}
<section id="what-we-are-building">
  <div class="section-heading">
    <h2>What We're Building</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% if overview.problemStatement %}
    <p style="font-size: 1rem; line-height: 1.7; margin-bottom: 12px;">{{ overview.problemStatement | jargon }}</p>
    {% endif %}
    {% if overview.challenges | length > 0 %}
    <h3 class="font-semibold mt-4 mb-2" style="font-size: 0.95rem;">Challenges We're Addressing</h3>
    <ul class="bullet-list">
      {% for c in overview.challenges %}
      <li>{{ c | jargon }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if overview.benefits | length > 0 %}
    <h3 class="font-semibold mt-4 mb-2" style="font-size: 0.95rem;">Expected Benefits</h3>
    <ul class="bullet-list">
      {% for b in overview.benefits %}
      <li>{{ b | jargon }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>

{# ── What It Does ─────────────────────────────────────────── #}
<section id="what-it-does">
  <div class="section-heading">
    <h2>What It Does</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% set mvp_caps = capabilities | selectattr("phase", "equalto", "MVP") | list %}
    {% set future_caps = capabilities | selectattr("phase", "equalto", "Future") | list %}

    {% if mvp_caps | length > 0 %}
    {% for c in mvp_caps %}
    <div class="card mb-2">
      <div class="font-semibold" style="font-size: 0.9rem;">{{ c.name | jargon }}</div>
      <div class="text-muted" style="font-size: 0.85rem;">{{ c.description | jargon }}</div>
    </div>
    {% endfor %}
    {% endif %}

    {% if future_caps | length > 0 %}
    <h3 class="font-semibold mt-4 mb-2" style="font-size: 0.95rem; color: var(--muted);">Planned for Later</h3>
    <ul class="bullet-list">
      {% for c in future_caps %}
      <li><strong>{{ c.name | jargon }}:</strong> {{ c.description | jargon }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if capabilities | length == 0 %}
    <p class="text-muted" style="font-size: 0.85rem; font-style: italic;">Capabilities are still being defined.</p>
    {% endif %}
  </div>
</section>

{# ── What It Connects To ─────────────────────────────────── #}
<section id="what-it-connects-to">
  <div class="section-heading">
    <h2>What It Connects To</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% set mvp_integrations = integrations | selectattr("phase", "equalto", "MVP") | list %}
    {% if mvp_integrations | length > 0 %}
    {% for i in mvp_integrations %}
    <div class="card mb-2">
      <div class="font-semibold" style="font-size: 0.9rem;">{{ i.name | jargon }}</div>
      <div class="text-muted" style="font-size: 0.85rem;">{{ i.purpose | jargon }}</div>
    </div>
    {% endfor %}
    {% else %}
    <p class="text-muted" style="font-size: 0.85rem; font-style: italic;">Connections are still being defined.</p>
    {% endif %}
  </div>
</section>

{# ── Approach ────────────────────────────────────────────── #}
<section id="approach">
  <div class="section-heading">
    <h2>Approach</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% if architecture.buildPath == "custom-agent" %}
    <p style="font-size: 0.95rem;">We're building a custom AI agent tailored to your needs.</p>
    {% elif architecture.buildPath == "declarative-agent" %}
    <p style="font-size: 0.95rem;">We're recommending a configuration-based agent that works inside Microsoft 365 Copilot — no custom development needed.</p>
    {% elif architecture.buildPath == "first-party-only" %}
    <p style="font-size: 0.95rem;">Microsoft already offers built-in agents that cover these needs — we recommend using those directly.</p>
    {% else %}
    <p style="font-size: 0.95rem;">{{ architecture.patternReasoning | jargon }}</p>
    {% endif %}

    {% if architecture.frontierAgentMatch | length > 0 %}
    <h3 class="font-semibold mt-4 mb-2" style="font-size: 0.95rem;">Leveraging Microsoft's Built-In Agents</h3>
    {% for m in architecture.frontierAgentMatch %}
    <div class="card mb-2">
      <div class="font-semibold" style="font-size: 0.9rem;">{{ m.agentName }}</div>
      <div class="text-muted" style="font-size: 0.85rem;">
        {% if m.coverage == "full" %}Already handles all matched capabilities.
        {% elif m.coverage == "partial" %}Handles some capabilities. We'll build the remaining functionality as a custom addition.
        {% else %}{{ m.notes | jargon }}{% endif %}
      </div>
    </div>
    {% endfor %}
    {% endif %}
  </div>
</section>

{# ── Key Decisions ───────────────────────────────────────── #}
<section id="key-decisions">
  <div class="section-heading">
    <h2>Key Decisions</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% set confirmed = decisions | selectattr("status", "ne", "pending") | list %}
    {% set pending = decisions | selectattr("status", "equalto", "pending") | list %}

    {% if confirmed | length > 0 %}
    {% for d in confirmed %}
    {% set selected = none %}
    {% for o in d.options %}{% if o.id == d.selectedOptionId %}{% set selected = o %}{% endif %}{% endfor %}
    <div class="card mb-2">
      <div class="font-semibold" style="font-size: 0.9rem;">{{ d.title | jargon }}</div>
      {% if selected %}
      <div class="text-muted" style="font-size: 0.85rem;">{{ selected.summary | jargon }}</div>
      {% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if pending | length > 0 %}
    <h3 class="font-semibold mt-4 mb-2" style="font-size: 0.95rem; color: var(--amber);">Awaiting Your Input</h3>
    {% for d in pending %}
    <div class="card accent-left accent-amber mb-2">
      <div class="font-semibold" style="font-size: 0.9rem;">{{ d.title | jargon }}</div>
      <div class="text-muted" style="font-size: 0.85rem;">{{ d.context | jargon }}</div>
    </div>
    {% endfor %}
    {% endif %}

    {% if decisions | length == 0 %}
    <p class="text-muted" style="font-size: 0.85rem; font-style: italic;">No decisions to report yet.</p>
    {% endif %}
  </div>
</section>

{# ── Status ──────────────────────────────────────────────── #}
<section id="status">
  <div class="section-heading">
    <h2>Current Status</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    <div class="card accent-left accent-primary">
      <div class="font-semibold" style="font-size: 1rem;">
        {% if workflow.phase == "preview" %}Design in progress
        {% elif workflow.phase == "research" %}Research and design complete — ready for build
        {% elif workflow.phase == "build" %}Build in progress
        {% elif workflow.phase == "evaluate" %}Built and testing — {{ metrics.overallPassRate | default("N/A") }}% of tests passing
        {% elif workflow.phase == "deploy" %}Ready for deployment
        {% else %}{{ workflow.phase }}{% endif %}
      </div>
      <div class="text-muted" style="font-size: 0.85rem; margin-top: 4px;">
        Readiness: {{ metrics.readiness }}%
      </div>
    </div>
  </div>
</section>

{# ── What's Next ─────────────────────────────────────────── #}
<section id="whats-next">
  <div class="section-heading">
    <h2>What's Next</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    <ul class="bullet-list">
      {% if metrics.pendingDecisions > 0 %}
      <li>Resolve {{ metrics.pendingDecisions }} pending decision{{ "s" if metrics.pendingDecisions > 1 }}</li>
      {% endif %}
      {% if metrics.openQuestionCount > 0 %}
      <li>Answer {{ metrics.openQuestionCount }} open question{{ "s" if metrics.openQuestionCount > 1 }}</li>
      {% endif %}
      {% if workflow.phase == "preview" or workflow.phase == "research" %}
      <li>Begin building the agent in Microsoft Copilot Studio</li>
      {% elif workflow.phase == "build" %}
      <li>Complete build and run evaluation tests</li>
      {% elif workflow.phase == "evaluate" %}
      <li>Address any failing tests and prepare for deployment</li>
      {% else %}
      <li>Deploy to production environment</li>
      {% endif %}
    </ul>
  </div>
</section>

{# ── Open Questions for Your Team ────────────────────────── #}
{% set unanswered = openQuestions | selectattr("status", "ne", "resolved") | list %}
{% if unanswered | length > 0 %}
<section id="questions">
  <div class="section-heading">
    <h2>Questions for Your Team</h2>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    <ol style="padding-left: 20px; font-size: 0.9rem; line-height: 1.8;">
      {% for q in unanswered %}
      <li>{{ q.question | jargon }}</li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}
{% endblock %}
