{# ── Combined Export — Agent Spec + Evals + How-To Guide ─────── #}
{# Single self-contained HTML with tabbed navigation.             #}
{# No-JS fallback: all panels visible. Print: all panels shown.  #}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ overview.name }} — Agent Export</title>
  <style>{{ css | safe }}</style>
</head>
<body>

  <header class="report-header">
    {{ ms_logo_svg }}
    <span class="header-label">Microsoft</span>
    <span class="header-spacer"></span>
    <span class="header-right">{{ overview.name }} — Agent Export</span>
    <button class="print-btn" id="print-btn" title="Print or save as PDF">Print / PDF</button>
  </header>

  <div class="report-wrapper">
    <div class="report-main">

      {# ── Title Block ──────────────────────────────────────── #}
      <div class="title-block">
        <h1>{{ overview.name }}</h1>
        {% if overview.description %}
        <p class="description">{{ overview.description }}</p>
        {% endif %}
        <div class="title-meta">
          <span>{{ generated_date }}</span>
          <span class="text-subtle">|</span>
          <span class="pill {{ workflow.phase | status_class }}">{{ workflow.phase }}</span>
          {% if metrics.readiness is defined %}
          <span class="text-subtle">|</span>
          <span class="readiness-inline">
            <span class="readiness-label">Readiness</span>
            <span class="readiness-bar-bg">
              <span class="readiness-bar-fill" style="width: {{ metrics.readiness }}%"></span>
            </span>
            <span class="readiness-value">{{ metrics.readiness }}%</span>
          </span>
          {% endif %}
        </div>
      </div>

      {# ── Tab Bar ──────────────────────────────────────────── #}
      <div class="tab-bar" role="tablist" aria-label="Report sections">
        <button class="tab active" role="tab" aria-selected="true" aria-controls="panel-brief" data-tab="brief">Agent Spec</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="panel-evals" data-tab="evals">Evaluations</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="panel-guide" data-tab="guide">How-To Guide</button>
      </div>

      {# ═══════════════════════════════════════════════════════ #}
      {# TAB 1 — Agent Spec                                     #}
      {# ═══════════════════════════════════════════════════════ #}
      <div class="tab-panel active" id="panel-brief" role="tabpanel">
        <h2 class="tab-panel-title print-only">Agent Spec</h2>

        {% include "sections/metrics-bar.njk" %}
        {% include "sections/overview.njk" %}
        {% include "sections/architecture.njk" %}
        {% include "sections/instructions.njk" %}
        {% include "sections/capabilities.njk" %}
        {% include "sections/integrations.njk" %}
        {% include "sections/knowledge.njk" %}
        {% include "sections/topics.njk" %}
        {% include "sections/scope.njk" %}
        {% include "sections/decisions.njk" %}
        {% include "sections/open-questions.njk" %}
        {% include "sections/cross-reference.njk" %}
      </div>

      {# ═══════════════════════════════════════════════════════ #}
      {# TAB 2 — Evaluations                                   #}
      {# ═══════════════════════════════════════════════════════ #}
      <div class="tab-panel" id="panel-evals" role="tabpanel">
        <h2 class="tab-panel-title print-only">Evaluations</h2>

        {# Eval summary metrics #}
        {% from "macros/cards.njk" import metric_card, chart %}
        <div class="metrics-bar">
          {{ metric_card(metrics.totalTests, "Total Tests") }}
          {{ metric_card(metrics.testedTests, "Tested") }}
          {{ metric_card(metrics.passedTests, "Passed") }}
          {% if metrics.overallPassRate is not none %}
          {{ metric_card(metrics.overallPassRate, "Pass Rate", "%") }}
          {% endif %}
        </div>

        {% include "sections/evals.njk" %}
      </div>

      {# ═══════════════════════════════════════════════════════ #}
      {# TAB 3 — How-To Guide                                  #}
      {# ═══════════════════════════════════════════════════════ #}
      <div class="tab-panel" id="panel-guide" role="tabpanel">
        <h2 class="tab-panel-title print-only">How-To Guide</h2>
        {% include "sections/guide.njk" %}
      </div>

    </div>
  </div>

  <footer class="report-footer">
    <span>{{ generated_date }}</span>
    <span>Confidential</span>
    <span>Generated by MCS Agent Builder</span>
  </footer>

  <script>{{ js | safe }}</script>
</body>
</html>
