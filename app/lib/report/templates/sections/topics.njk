{% from "macros/cards.njk" import phase_pill %}

<section id="topics">
  <div class="section-heading">
    <h2>Conversation Topics</h2>
    <span class="subtitle">{{ topics | length }} total</span>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% if topics | length > 0 %}
    <table class="data-table">
      <thead><tr><th>Topic</th><th>Type</th><th>Trigger</th><th>Output</th><th>Phase</th></tr></thead>
      <tbody>
        {% for t in topics %}
        <tr>
          <td>{{ t.name }}</td>
          <td class="cell-muted">{{ t.type }}</td>
          <td class="cell-muted">{{ t.triggerType | safe_val }}</td>
          <td class="cell-muted">{{ t.outputFormat | safe_val }}</td>
          <td>{{ phase_pill(t.phase) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {# Expanded topic details #}
    {% for t in topics %}
    {% if t.description or t.implements | length > 0 or t.connectedIntegrations | length > 0 %}
    <details class="card mt-2" style="cursor: pointer;">
      <summary class="font-semibold" style="font-size: 0.9rem;">{{ t.name }}</summary>
      <div style="margin-top: 8px;">
        {% if t.description %}
        <p style="font-size: 0.85rem; margin-bottom: 6px;">{{ t.description }}</p>
        {% endif %}
        {% if t.implements | length > 0 %}
        <p class="text-muted" style="font-size: 0.82rem;"><strong>Implements:</strong> {{ t.implements | join(", ") }}</p>
        {% endif %}
        {% if t.connectedIntegrations | length > 0 %}
        <p class="text-muted" style="font-size: 0.82rem;"><strong>Connected Integrations:</strong> {{ t.connectedIntegrations | join(", ") }}</p>
        {% endif %}
        {% if t.flowDescription %}
        <pre class="code-block" style="font-size: 0.75rem; margin-top: 6px;">{{ t.flowDescription }}</pre>
        {% endif %}
      </div>
    </details>
    {% endif %}
    {% endfor %}
    {% else %}
    <p class="text-muted" style="font-size: 0.85rem; font-style: italic;">No conversation topics defined yet.</p>
    {% endif %}
  </div>
</section>
