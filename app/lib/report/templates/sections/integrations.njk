{% from "macros/cards.njk" import phase_pill, status_pill, chart %}

<section id="integrations">
  <div class="section-heading">
    <h2>Integrations</h2>
    <span class="subtitle">{{ integrations | length }} total</span>
    <span class="toggle-icon">&#9662;</span>
  </div>
  <div class="section-body">
    {% if charts.integration_auth %}
    <h3 class="font-semibold mb-2" style="font-size: 0.95rem;">Auth Methods</h3>
    {{ chart(charts.integration_auth) }}
    {% endif %}

    {% if integrations | length > 0 %}
    <table class="data-table">
      <thead><tr><th>Integration</th><th>Type</th><th>Auth</th><th>Purpose</th><th>Phase</th></tr></thead>
      <tbody>
        {% for i in integrations %}
        <tr>
          <td>{{ i.name }}</td>
          <td class="cell-muted">{{ i.type }}</td>
          <td class="cell-muted">{{ i.auth | safe_val }}</td>
          <td>{{ i.purpose }}</td>
          <td>{{ phase_pill(i.phase) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="text-muted" style="font-size: 0.85rem; font-style: italic;">No integrations defined yet.</p>
    {% endif %}
  </div>
</section>
