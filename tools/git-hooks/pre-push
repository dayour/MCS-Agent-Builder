#!/bin/sh
#
# Pre-push hook — block pushes to read-only research remotes. No other side effects.
#
# History: this hook used to run a contract-parity check and an om-cli auto-rebuild
# (which auto-committed binary changes via --no-verify, bypassing test-guard and
# view-integrity hooks). Both removed 2026-05-04 — commit/push must do nothing
# except commit and push. Run `npm run contracts:check` manually before pushing
# if you want the contract gate. Run `/mcs-sync` weekly to surface om-cli updates
# as triage cards.

REMOTE_NAME="$1"
case "$REMOTE_NAME" in
  elevate)
    echo "[pre-push] BLOCKED: '$REMOTE_NAME' is a read-only research remote." >&2
    echo "[pre-push] Push to 'origin' (microsoft/MCS-Agent-Builder) instead." >&2
    exit 1
    ;;
esac

exit 0
