{
  "name": "mcs-agent-builder",
  "version": "1.0.2",
  "description": "Microsoft Copilot Studio agent build automation with Claude Code",
  "author": "Microsoft CAPE Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/MCS-Agent-Builder"
  },
  "bin": {
    "mcs": "bin/cli.js",
    "mcsab": "bin/cli.js",
    "mcs-agent-builder": "bin/cli.js"
  },
  "files": [
    "bin/",
    "app/server.js",
    "app/terminal-server.js",
    "app/lib/",
    "app/dist/",
    "app/frontend/",
    "knowledge/",
    "tools/",
    "templates/",
    ".claude/",
    ".mcp.json",
    "start.js",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node start.js",
    "server": "node app/server.js",
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "npm --prefix app/frontend install && npm --prefix app/frontend run build",
    "test": "node tools/direct-line-test.js",
    "frontend:dev": "npm --prefix app/frontend run dev",
    "frontend:build": "npm --prefix app/frontend install && npm --prefix app/frontend run build"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.1.1",
    "turndown": "^7.2.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
